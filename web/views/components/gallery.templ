package components

import (
	"cmp"

	"workshop/internal/domain/sighting"
)

templ MediaGrid(s sighting.Sighting, items []sighting.Media) {
	if len(items) == 0 {
		<p class="empty">No photos were recorded for this sighting.</p>
	} else {
		<ul class="detail__thumbs">
			for _, m := range items {
				<li>
					if m.Type == "StillImage" && m.URL != "" {
						<a href={ templ.URL(m.URL) } data-lightbox data-caption={ credit(m) }>
							<img src={ m.URL } alt={ photoAlt(s, m) } loading="lazy" width="400" height="300"/>
						</a>
					} else if m.URL != "" {
						<a href={ templ.URL(m.URL) } rel="noopener">{ altText(m) }</a>
					}
				</li>
			}
		</ul>
	}
}

func altText(m sighting.Media) string {
	return cmp.Or(m.Title, m.Description, "Sighting media")
}
